// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  role          Role      @default(EDITOR)
  passwordHash  String
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  posts         Post[]
  media         Media[]
  sessions      Session[]
  accounts      Account[]
  auditLogs     AuditLog[] @relation("UserAuditLogs")

  @@map("users")
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Post {
  id            String      @id @default(cuid())
  title         Json        // {fr: "...", en: "..."}
  slug          String      @unique
  content       Json        // {fr: "...", en: "..."}
  excerpt       Json?       // {fr: "...", en: "..."}
  featuredImage String?
  status        PostStatus  @default(DRAFT)
  type          PostType    @default(NEWS)
  featured      Boolean     @default(false)
  publishedAt   DateTime?
  views         Int         @default(0)
  
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id])
  
  tags          Tag[]
  media         Media[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("posts")
  @@index([slug])
  @@index([status, publishedAt])
  @@index([type])
  @@index([featured])
}

model Category {
  id          String   @id @default(cuid())
  name        Json     // {fr: "...", en: "..."}
  slug        String   @unique
  description Json?
  color       String?
  icon        String?
  order       Int      @default(0)
  
  posts       Post[]
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  parentId    String?
  children    Category[] @relation("CategoryHierarchy")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
  @@index([slug])
  @@index([order])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  posts     Post[]

  @@map("tags")
  @@index([slug])
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  thumbnailUrl String?
  alt          String?
  caption      String?
  dimensions   Json?    // {width, height}
  
  uploaderId   String
  uploader     User     @relation(fields: [uploaderId], references: [id])
  posts        Post[]

  createdAt    DateTime @default(now())

  @@map("media")
  @@index([uploaderId])
  @@index([mimeType])
}

model Page {
  id              String     @id @default(cuid())
  title           Json       // {fr: "...", en: "..."}
  slug            String     @unique
  content         Json       // {fr: "...", en: "..."}
  status          PostStatus @default(DRAFT)
  template        String     @default("default")
  metaTitle       Json?
  metaDescription Json?
  order           Int        @default(0)
  
  // Service-specific fields
  serviceType     String?    // visa, passeport, carte-consulaire, etc.
  requiredDocs    Json?      // {fr: [...], en: [...]} - List of required documents
  fees            Json?      // {standard: 50, express: 75, ...}
  processingTime  Json?      // {fr: "...", en: "..."}
  paymentLink     String?    // External payment URL
  formLink        String?    // External form URL
  
  parent          Page?      @relation("PageHierarchy", fields: [parentId], references: [id])
  parentId        String?
  children        Page[]     @relation("PageHierarchy")

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  publishedAt     DateTime?

  @@map("pages")
  @@index([slug])
  @@index([status])
  @@index([order])
  @@index([serviceType])
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value Json
  type  String @default("text")
  
  @@map("settings")
  @@index([key])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // CREATE, UPDATE, DELETE
  entity    String   // User, Post, etc.
  entityId  String
  userId    String?
  user      User?    @relation("UserAuditLogs", fields: [userId], references: [id])
  data      Json?    // Before/after data
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
}

enum PostStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum PostType {
  NEWS
  EVENT
  SERVICE
  ANNOUNCEMENT
  DOCUMENTATION
}