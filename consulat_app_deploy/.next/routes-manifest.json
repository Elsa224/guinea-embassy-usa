{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/actualites",
      "regex": "^/actualites(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/actualites(?:/)?$"
    },
    {
      "page": "/contacts",
      "regex": "^/contacts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contacts(?:/)?$"
    },
    {
      "page": "/cote-divoire",
      "regex": "^/cote\\-divoire(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/cote\\-divoire(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/mediatheque",
      "regex": "^/mediatheque(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/mediatheque(?:/)?$"
    },
    {
      "page": "/services",
      "regex": "^/services(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services(?:/)?$"
    },
    {
      "page": "/services/autres-documents",
      "regex": "^/services/autres\\-documents(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services/autres\\-documents(?:/)?$"
    },
    {
      "page": "/services/etat-civil",
      "regex": "^/services/etat\\-civil(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services/etat\\-civil(?:/)?$"
    },
    {
      "page": "/services/passeport",
      "regex": "^/services/passeport(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services/passeport(?:/)?$"
    },
    {
      "page": "/services/visa",
      "regex": "^/services/visa(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services/visa(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}